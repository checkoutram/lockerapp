{
	"appId": "com.vlocker.app",
	"appName": "vlocker",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"allowMixedContent": true
	},
	"ios": {
		"contentInset": "always",
		"scheme": "vlocker",
		"allowsLinkPreview": false,
		"scrollEnabled": true,
		"backgroundColor": "#0A1628"
	},
	"plugins": {
		"Camera": {
			"saveToGallery": false
		}
	},
	"packageClassList": [
		"CAPCameraPlugin",
		"FilesystemPlugin",
		"PreferencesPlugin",
		"SharePlugin",
		"NativeBiometricPlugin"
	]
}
